{
  "name": "tubemusic",
  "version": "1.1.0-beta.2",
  "description": "Custom desktop client with Discord RPC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:private": "electron-builder --win --config electron-builder.private.yml"
  },
  "author": "Danurchik",
  "license": "ISC",
  "build": {
    "appId": "com.tm.desktop",
    "productName": "TubeMusic",
    "files": [
      "main.js",
      "preload.js",
      "widget-preload.js",
      "widget.html",
      "mini-player.html",
      "*.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "TubeMusic_icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Danurchik",
      "repo": "TubeMusic"
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9",
    "png-to-ico": "^3.0.2"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
